{
  "manifest_version": 3,
  "name": "Tab Reminder",
  "version": "1.1.0",
  "description": "Close tabs now, get them back (and a notification) at a time you choose.",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Reminder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
